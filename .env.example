# Template — copy to .env and fill in. The real .env is gitignored.
#
# Cloudflare R2 API token (Object Read is enough for listing/reading videos).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 S3-compatible endpoint + bucket for "studybuddy".
R2_ENDPOINT=https://b6c4f328e1926274c890083e6942b54e.r2.cloudflarestorage.com
R2_BUCKET=studybuddy

# Public base URL used by the website's <video> playback (r2.dev subdomain or custom domain).
R2_BASE=
